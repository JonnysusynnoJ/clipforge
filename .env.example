# Copy to .env and fill in. Never commit .env.

# Optional: Apify token, only needed if public Whop discovery fails (Phase 2).
APIFY_TOKEN=

# Google service account key file used to read campaign material and
# upload rendered clips to Google Drive (Phase 1/4).
GOOGLE_SERVICE_ACCOUNT_FILE=

# Optional: only needed if you run LLM steps via the API instead of the
# Claude agent session (default: agent session, no key needed).
ANTHROPIC_API_KEY=

# Optional: path to the non-secret config file (default: config.yaml).
CLIPFORGE_CONFIG=config.yaml
